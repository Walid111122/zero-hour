# ---------- Unity ----------
client/Library/
client/Temp/
client/Obj/
client/Build/
client/Builds/
client/Logs/
client/UserSettings/
client/MemoryCaptures/
client/Recordings/

# Scaffolding written by com.unity.test-framework.performance (a transitive dependency of
# the Test Framework, not something we asked for). Regenerated on every test run and it
# records machine/build state -- "BuildTarget":"WebGL", editor changeset, the full package
# list -- so it churns constantly and would conflict between machines.
#
# Worth noting *where* it lands: Assets/Resources/ ships inside the player build, so this is
# junk that would otherwise be committed and then shipped. Resources.meta stays tracked to
# keep the folder GUID stable.
client/Assets/Resources/PerformanceTestRunInfo.json*
client/Assets/Resources/PerformanceTestRunSettings.json*

# Burst intermediates from a WebGL player build. Note this lands in client/Data/,
# *outside* client/Build/, so the build-output rule above does not cover it — found
# only because a build was actually run and `git status` then showed it untracked.
client/Data/

# Android build scratch space. Same story as client/Data/ above: it sits outside
# client/Build/, so nothing else here catches it, and it only turned up after an
# Android build actually completed.
client/.utmp/


client/[Aa]ssets/AssetStoreTools*
client/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity-generated project files (regenerated on open)
client/*.csproj
client/*.unityproj
client/*.sln
client/*.suo
client/*.user
client/*.userprefs
client/*.pidb
client/*.booproj
client/*.svd
client/*.pdb.meta
client/*.mdb.meta
client/sysinfo.txt

# Crash reports
client/crashlytics-build.properties

# ---------- .NET ----------
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.suo
*.userosscache
*.sln.docstates
TestResults/
*.trx
*.coverage
*.coveragexml
.vs/
artifacts/

# ---------- Cline <-> Unity Bridge (runtime only, never committed) ----------
# Leading slash anchors this to the repo root. Unanchored, it also swallowed
# client/Assets/_Project/Scripts/Editor/Bridge/ — the Bridge *source*, which must be
# committed. Git ignores silently, so the loss only surfaced on a restore.
/bridge/

# ---------- Unity batch-mode logs from scripted editor invocations ----------
unity-*.log

# ---------- Local SQLite development database ----------
# Never committed. It is a developer's scratch state, it drifts from the migrations the
# moment anyone edits a row by hand, and a stale one masks a broken migration by already
# having the tables. Postgres is the truth (`15`).
*.db
*.db-shm
*.db-wal

# ---------- Generated Sim symbols ----------
# The DLL itself IS committed so a fresh clone opens in Unity without a build step.
# The .pdb is a local debugging convenience and churns on every rebuild.
client/Assets/Plugins/ZeroHour.Sim/*.pdb
client/Assets/Plugins/ZeroHour.Sim/*.pdb.meta

# ---------- Secrets & local config ----------
.env
.env.*
!.env.example
*.keystore
!debug.keystore
*.pfx
*.p12
secrets.json
appsettings.Local.json
appsettings.Development.local.json

# ---------- Tooling ----------
.idea/
*.swp
.DS_Store
Thumbs.db
node_modules/

# ---------- Build output ----------
dist/
publish/
