# ---------- Cline <-> Unity Bridge (runtime only, never committed) ----------
# Leading slash anchors this to the repo root. Unanchored, it also swallowed
# client/Assets/_Project/Scripts/Editor/Bridge/ — the Bridge *source*, which must be
# committed. Git ignores silently, so the loss only surfaced on a restore.
/bridge/

# ---------- Unity batch-mode logs from scripted editor invocations ----------
unity-*.log

# ---------- Generated Sim symbols ----------
# The DLL itself IS committed so a fresh clone opens in Unity without a build step.
# The .pdb is a local debugging convenience and churns on every rebuild.
client/Assets/Plugins/ZeroHour.Sim/*.pdb
client/Assets/Plugins/ZeroHour.Sim/*.pdb.meta

