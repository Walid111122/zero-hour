# Zero Hour — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# `.env` is gitignored (`.env` + `.env.*`, with `!.env.example` re-including this file).
# On a server, `.env` is owned by the deploy user with 600 permissions (`24 §7`).
# Never put a real secret in THIS file — it is committed.
#
# Names use the ASP.NET Core double-underscore convention, so `ConnectionStrings__Postgres`
# binds to `Configuration.GetConnectionString("Postgres")` with no extra parsing code.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# The container listens here; the reverse proxy terminates TLS in front of it (`24 §2`).
ASPNETCORE_URLS=http://+:8080

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------
# Both bind to the Docker network only and are never published to a public
# interface (`24 §2`).
#
# THESE TWO ARE FOR HOST-SIDE TOOLS ONLY — `dotnet ef`, psql, a local `dotnet run`.
# The app container no longer reads them: docker-compose.yml builds its own connection
# strings from the POSTGRES_* values below, pinned to the compose service names. That
# split exists because the correct host differs by context (`localhost` from the host,
# `postgres` from inside the network), and one variable cannot be right for both. Set
# these to whatever your host-side tooling needs; it will not affect the container.

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=zerohour;Username=zerohour;Password=CHANGE_ME
ConnectionStrings__Redis=localhost:6379

# Used by the postgres container on first run, and by compose to build the app
# container's connection string — so these are the authoritative credentials.
# Keep the host-side strings above in sync with them; drift produces an
# authentication failure that reads like a network problem.
POSTGRES_DB=zerohour
POSTGRES_USER=zerohour
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Rotate on any suspicion of exposure, and at least annually (`24 §7`).
# Generate: openssl rand -base64 48
# Rotating this invalidates every issued token, so every client is logged out.

Jwt__SigningKey=CHANGE_ME_min_32_bytes_of_random
Jwt__Issuer=zerohour
Jwt__Audience=zerohour-client
Jwt__AccessTokenMinutes=60

# ---------------------------------------------------------------------------
# Deferred — uncomment in the phase that introduces the service
# ---------------------------------------------------------------------------
# Voice SFU, Phase 4 (`10`)
# LiveKit__Url=ws://livekit:7880
# LiveKit__ApiKey=CHANGE_ME
# LiveKit__ApiSecret=CHANGE_ME

# Translation, Phase 4 (`10 §6`)
# LibreTranslate__Url=http://libretranslate:5000

# Store receipt validation, Phase 7 (`13 §7`)
# Google__PlayServiceAccountJson=/run/secrets/play-service-account.json
# Apple__SharedSecret=CHANGE_ME
